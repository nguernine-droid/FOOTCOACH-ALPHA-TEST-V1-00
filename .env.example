# PostgreSQL (conteneur)
POSTGRES_USER=footcoach
POSTGRES_PASSWORD=changeme-in-prod
POSTGRES_DB=footcoach

# API
# En Docker, l'hôte est le nom du service compose : postgres
DATABASE_URL=postgres://footcoach:changeme-in-prod@postgres:5432/footcoach
JWT_ACCESS_SECRET=changeme-access-secret-32-chars-min
JWT_REFRESH_SECRET=changeme-refresh-secret-32-chars-min
API_PORT=4000

# Web
# URL interne de l'API vue depuis le conteneur web (proxy Next rewrites)
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
