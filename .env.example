# PostgreSQL (conteneur)
#
# La valeur ci-dessous est un mot de passe de DÉVELOPPEMENT, écrit dans le dépôt
# et donc public. Elle ne tient que parce que le port 5433 n'est publié que sur
# 127.0.0.1 (voir docker-compose.yml). En production, docker-compose.prod.yml
# refuse de démarrer sans POSTGRES_PASSWORD explicite : générez-en un dédié
# (openssl rand -base64 32) et ne réutilisez jamais celui-ci.
POSTGRES_USER=footcoach
POSTGRES_PASSWORD=changeme-in-prod
POSTGRES_DB=footcoach

# API
# En Docker, l'hôte est le nom du service compose : postgres
DATABASE_URL=postgres://footcoach:changeme-in-prod@postgres:5432/footcoach
# Deux secrets DISTINCTS, 32 caractères minimum en production, à générer une
# fois : openssl rand -base64 48
# L'API refuse de démarrer en production si l'un d'eux garde sa valeur de
# développement, est trop court, ou si les deux sont identiques.
JWT_ACCESS_SECRET=changeme-access-secret-32-chars-min
JWT_REFRESH_SECRET=changeme-refresh-secret-32-chars-min
API_PORT=4000

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. Vide en production = aucune origine tierce, ce qui est le réglage
# attendu : le navigateur passe par le proxy du service web.
CORS_ORIGINS=

# Lève les plafonds de débit, pour la simulation de charge uniquement
# (tools/simulation). Refusé si NODE_ENV=production.
RATE_LIMIT_DISABLED=

# Sauts de confiance devant l'API, pour établir l'adresse des clients — donc
# leur compteur de limitation de débit. Vide = ne croire personne (défaut sûr :
# l'adresse retenue est celle du conteneur web, la limitation reste correcte
# mais grossière pour le trafic anonyme).
#
# ⚠️ Next NE COMPLÈTE PAS X-Forwarded-For : il ne le pose que s'il est absent.
# Un en-tête envoyé par un client traverse donc le service web intact. Ne
# renseigner cette variable QUE derrière un reverse proxy configuré pour y
# ajouter l'adresse réelle :
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#
# Avec un reverse proxy dans le réseau Docker : loopback,uniquelocal
# Alternative équivalente, par nombre de sauts (nginx puis web) : 2
TRUST_PROXY=

# Notifications Web Push (optionnel : sans ces clés, le réglage est masqué)
# Générer une paire propre au déploiement : npx web-push generate-vapid-keys
# La clé privée ne doit jamais être committée. La clé publique, si.
# Rappel : le push exige HTTPS, et sur iOS que l'app soit ajoutée à l'écran d'accueil.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.fr

# Web
# URL interne de l'API vue depuis le conteneur web (proxy Next rewrites)
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Site vitrine qui publie les CGU, la politique de confidentialité et les
# mentions légales (dossier `site/` du dépôt). C'est vers lui que pointent les
# liens de l'écran d'acceptation, à l'inscription.
#
# Il doit être EN LIGNE avant d'ouvrir les inscriptions : un coach doit pouvoir
# lire le texte complet avant de l'accepter. Pour travailler les textes en
# local : cd site && python -m http.server 4173, puis pointer ici.
NEXT_PUBLIC_SITE_URL=https://footcoach.fr
